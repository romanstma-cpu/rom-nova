# ROM Nova environment. Copy to .env.local and fill what you have.
#
# EVERYTHING HERE IS OPTIONAL. With no keys at all the app is NOT in demo mode:
# five keyless sources carry most of the terminal — Jupiter (tokens, holders,
# concentration, creator history), GeckoTerminal (price history), Solana
# JSON-RPC (mint/freeze authority), SQD (wallet flow) and RugCheck (rug and
# LP-lock risk), plus a cross-checked SOL reference price.
#
# What keys buy you is the rest: wallet activity (Helius) and holder labelling
# (Birdeye). Wallet activity and smart-money scoring stay simulated without
# them, and the data-mode chip in the app says so on every screen.

# ---------------------------------------------------------------- chain / data
# Solana RPC + WebSocket (Helius URLs work here too)
SOLANA_RPC_URL=
SOLANA_WS_URL=

# Helius — enhanced wallet transactions, webhooks (https://helius.dev)
HELIUS_API_KEY=

# Birdeye — OHLCV, token security, holder positions/labels (https://birdeye.so)
BIRDEYE_API_KEY=

# Jupiter — Tokens V2. NO KEY NEEDED: the adapter targets the free
# lite-api.jup.ag tier by default and it is the app's primary token source,
# supplying holder count, top-holder share, dev balance, organic score, creator
# mint history and per-interval price/volume change. A key switches it to
# api.jup.ag for a higher rate limit and nothing else.
JUPITER_API_KEY=

# Nansen — optional premium wallet labels / smart-money data
NANSEN_API_KEY=

# InfStones Blockchain Intelligence — third-opinion price cross-check
INFSTONES_API_KEY=

# CoinGecko — the free tier is keyless; a demo key raises rate limits
COINGECKO_API_KEY=

# DEX Screener is keyless; enable it as a fallback market source
ENABLE_DEXSCREENER=false

# ---------------------------------------------------------------- keyless
# These need no credentials and are ON by default. Set to false to disable.
#
# RugCheck — third-party risk grade, named risks, and LP LOCK STATE, which
# nothing else here can see. A deployer who can withdraw the pool does not need
# a mint authority to take the money.
ENABLE_RUGCHECK=true
# Solana's own JSON-RPC — mint and freeze authority, read from the chain.
ENABLE_SOLANA_RPC=true
# SQD Solana Portal — wallet-level flow (who actually moved the token).
ENABLE_SQD=true

# ---------------------------------------------------------------- flags
# Keyed providers activate when their key is present AND their flag isn't
# "false". Keyless ones (above) need only the flag.
ENABLE_JUPITER=true
ENABLE_BIRDEYE=true
ENABLE_HELIUS=true
ENABLE_NANSEN=true
ENABLE_COINGECKO=true
ENABLE_CRYPTOCOM=true
ENABLE_INFSTONES=true
# Live trading is NOT implemented in this build; the flag exists so the
# execution layer lands behind it, defaulted hard off.
ENABLE_REAL_TRADING=false

# ---------------------------------------------------------------- storage
# Demo mode is in-memory. Live mode persists into Postgres (db/schema.sql).
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
REDIS_URL=

# ---------------------------------------------------------------- app
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Demo universe seed + SOL anchor for the simulated path
ROMNOVA_DEMO_SEED=77
ROMNOVA_SOL_ANCHOR=
