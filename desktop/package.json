{
  "name": "rom-nova-desktop",
  "productName": "ROM Nova",
  "version": "1.28.0",
  "description": "Solana on-chain intelligence terminal: track any wallet off the chain, watch new pools triaged within seconds of launch, and audit every token's score against the security panel beside it. Part of ROM Apps.",
  "author": "ROM <roman3165@icloud.com>",
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --publish never",
    "release": "electron-builder --win nsis --publish always"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "xyz.romapps.nova",
    "productName": "ROM Nova",
    "artifactName": "ROM-Nova-Setup.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "rpc-proxy.js",
      "bridge.js",
      "window-state.js",
      "crash-guard.js",
      "icon.ico"
    ],
    "extraResources": [
      {
        "from": "../out",
        "to": "static"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false
    },
    "publish": {
      "provider": "github",
      "owner": "romanstma-cpu",
      "repo": "rom-nova",
      "releaseType": "release"
    }
  },
  "allowScripts": {
    "electron@33.4.11": true
  }
}
