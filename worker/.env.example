# ROM Nova Radar — copy to .env and fill in. NEVER commit .env.
# Paste keys here or into Render's environment dashboard yourself — keys
# must not travel through chats, issues, or commits.

# --- Required (unless DRY_RUN=1) -------------------------------------------
# Supabase → Project Settings → API. The SERVICE key stays server-side only.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# --- Optional --------------------------------------------------------------
# Helius (free tier works): extends coverage to tracked wallets' trades OFF
# the pump.fun curve. Without it the worker still runs — coverage is then
# pump.fun bonding-curve trades only, and /health says so.
HELIUS_API_KEY=

# Run with an in-memory store and no database — full pipeline, nothing persists.
DRY_RUN=

# --- Accounts and billing (1.21.0) -----------------------------------------
# Who may read the feed: open (default) | account | subscription.
RADAR_ACCESS=open
# account + subscription: the project's anon/publishable key (Project Settings
# → API). Public by design — the app fetches it from /config to sign in.
SUPABASE_ANON_KEY=
# subscription: Stripe → Developers → API keys (sk_test_… first, sk_live_… later)
STRIPE_SECRET_KEY=
# subscription: the recurring price to sell (Product catalog → the price → price_…)
STRIPE_PRICE_ID=
# subscription: the webhook endpoint's signing secret (Developers → Webhooks → whsec_…)
STRIPE_WEBHOOK_SECRET=
# Where Stripe sends people back: the app's origin plus base path.
APP_URL=https://romapps.xyz/nova
# A subscription whose period ended this many hours ago still counts (webhook lag).
ENTITLEMENT_GRACE_HOURS=24

# --- Gates (defaults shown) ------------------------------------------------
WHALE_THRESHOLD_SOL=10
WHALE_WINDOW_MIN=10
SIGNAL_MIN_SCORE=70
SIGNAL_MIN_SETTLED=3
SIGNAL_MIN_BUY_SOL=1

# --- Capacity --------------------------------------------------------------
MAX_TRACKED_WALLETS=200
HELIUS_WALLET_SUBS=20
HELIUS_RPS=6
PORT=8790
